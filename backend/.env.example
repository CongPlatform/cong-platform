# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/postgres
DATABASE_CA_CERT_PATH=./certs/supabase-ca.crt

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# SERVER-ONLY SECRET
# Never expose this value in frontend code or VITE_* variables.
SUPABASE_SECRET_KEY=your_supabase_secret_key

VITE_PUBLIC_SITE_ROOT_DOMAIN=cong.com.br

# Notificações por e-mail da moderação (opcional; configurar somente no backend).
# Chave da API Resend, independente do SMTP do Supabase Auth.
RESEND_API_KEY=re_your_resend_api_key
# Remetente em domínio verificado no Resend. Ex.: CONG <notificacoes@cong.com.br>
MODERATION_EMAIL_FROM=CONG <notificacoes@cong.com.br>

PIXABAY_API_KEY=sua_chave_aqui

GEOAPIFY_API_KEY=SUA_CHAVE_AQUI